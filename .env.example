# Copia questo file come .env, senza inserirlo nell'eseguibile o nel repository.
SMTP_HOST=smtp.fceitalia.it
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_TIMEOUT=15
SENDER_EMAIL=utente@example.com
SENDER_PASSWORD=password_o_app_password
RECEIVER_EMAIL=destinatario@example.com
EMAIL_INTERVAL_SECONDS=900
EMAIL_RETRY_SECONDS=60
MAX_BATCH_ENTRIES=100
DATA_RETENTION_DAYS=90
USER_RETENTION_DAYS=365

# Opzionali: directory persistente e file di configurazione alternativi.
# FASTCHARGE_DATA_DIR=/percorso/dati
# FASTCHARGE_CONFIG_FILE=/percorso/config.env
# QR_SIGNING_SECRET=segreto-condiviso-tra-piu-installazioni
